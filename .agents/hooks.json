{
  "coqui-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; exec python3 \"$root/tool/antigravity_guard_hook.py\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
