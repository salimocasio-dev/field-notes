    "docs": {
      "kind": "non_package",
      "paths": [
        "docs/**",
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md",
        "README.md",
        "coqui/AGENTS.md"
      ]
    },
    "content": {
      "kind": "non_package",
      "paths": [
        "content/**",
        "historia/tools/**",
        "historia/datos/**",
        "historia/libros/**",
        "historia/notas/**"
      ]
    },
    "tool": {
      "kind": "non_package",
      "paths": [
        "coqui/tool/**",
        "tools/**",
        "tool/**"
      ]
    },
    "design": {
      "kind": "design",
      "parents": [
        "coqui_ui",
        "docs"
      ],
      "paths": [
        "coqui/packages/core/coqui_ui/**",
        "docs/proyecto/noche/**"
      ]
    },
    "feature_library.reader": {
      "kind": "screen",
      "parents": [
        "feature_library"
      ],
      "paths": [
        "coqui/packages/features/feature_library/lib/src/reader/**",
        "coqui/packages/features/feature_library/lib/src/reader_*.dart",
        "coqui/packages/features/feature_library/lib/src/text_reader.dart",
        "coqui/packages/features/feature_library/test/reader/**",
        "coqui/packages/features/feature_library/test/reader_*.dart",
        "coqui/packages/features/feature_library/test/screenshots/reader_*.png"
      ]
    },
    "feature_library.shelf": {
      "kind": "screen",
      "parents": [
        "feature_library"
      ],
      "paths": [
        "coqui/packages/features/feature_library/lib/src/shelf/**",
        "coqui/packages/features/feature_library/lib/src/reading_home.dart",
        "coqui/packages/features/feature_library/lib/src/write_story_sheet.dart",
        "coqui/packages/features/feature_library/lib/src/story_generator.dart",
        "coqui/packages/features/feature_library/test/shelf/**",
        "coqui/packages/features/feature_library/test/reading_home_test.dart",
        "coqui/packages/features/feature_library/test/story_generator_test.dart",
        "coqui/packages/features/feature_library/test/screenshots/library_*.png"
      ]
    },
    "content.games": {
      "kind": "content_sublane",
      "parents": [
        "content"
      ],
      "paths": [
        "content/games/**"
      ]
    },
    "content.lines.es": {
      "template": "content_lines",
