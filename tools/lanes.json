    },
    "feature_map": {
      "kind": "package",
      "paths": [
        "coqui/packages/features/feature_map/**"
      ]
    },
    "feature_story": {
      "kind": "package",
      "paths": [
        "coqui/packages/features/feature_story/**"
      ]
    },
    "feature_review": {
      "kind": "package",
      "paths": [
        "coqui/packages/features/feature_review/**"
