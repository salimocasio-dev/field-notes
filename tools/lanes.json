{
  "version": 1,
  "shared_paths": [
    "coqui/requests/**"
  ],
  "package_root_prefix": "coqui/packages/",
  "multi_package_label": "multi-package-ok",
  "branch_rules": {
    "lane_prefix": "lane/",
    "story_prefix": "story/",
    "story_default_lane": "scene_port",
    "contracts_prefix": "contracts/",
    "contracts_owner_lane": "coqui_contracts",
    "contracts_conformance_paths": [
      "coqui/packages/**",
      "coqui/app/**"
    ]
  },
  "generated_path_groups": {
    "scene_manifests": [
      "coqui/packages/core/coqui_scenes/tool/dev_main.dart",
      "coqui/packages/core/coqui_scenes/tool/make_set_fixture.dart",
      "coqui/ref/pp/index.json"
    ]
  },
  "templates": {
    "scene": {
      "kind": "scene",
      "parents": [
        "coqui_scenes",
        "coqui_story_checks"
      ],
      "multi_package_ok": true,
      "generated_group": "scene_manifests",
      "paths": [
        "coqui/packages/core/coqui_scenes/lib/src/{id}/**",
        "coqui/packages/core/coqui_scenes/assets/sheets/{id}-sheet.json",
        "coqui/packages/core/coqui_scenes/test/{id}_acts_test.dart",
        "coqui/packages/core/coqui_scenes/test/{id}_asks_test.dart",
        "coqui/packages/core/coqui_scenes/test/{id}_boxes_test.dart",
        "coqui/packages/core/coqui_scenes/test/{id}_pictures_test.dart",
        "coqui/packages/core/coqui_scenes/test/{id}_preview_test.dart",
        "coqui/packages/core/coqui_scenes/test/{id}_set_test.dart",
        "coqui/packages/core/coqui_scenes/test/{id}_sprites_test.dart",
        "coqui/packages/core/coqui_scenes/test/support/{id}_preview_remap.dart",
        "coqui/packages/core/coqui_scenes/test/support/fixtures/{id}/**",
        "coqui/packages/core/coqui_scenes/test/support/fixtures/{id}_set_refs.dart",
        "coqui/packages/core/coqui_scenes/test/support/fixtures/{id}_sprite_refs.dart",
        "coqui/packages/core/coqui_scenes/test/support/fixtures/{id}_preview_fixture.dart",
        "coqui/packages/core/coqui_scenes/tool/{id}_frames_test.dart",
        "coqui/packages/core/coqui_scenes/tool/{id}_sprites_test.dart",
        "coqui/packages/core/coqui_scenes/tool/{id}_bake_parts_test.dart",
        "coqui/packages/core/coqui_scenes/tool/{id}_asks_ref.mjs",
        "coqui/packages/core/coqui_scenes/tool/make_{id}_sprites_test.dart",
        "coqui/packages/core/coqui_scenes/tool/make_{id}_still.dart",
        "coqui/packages/coqui_story_checks/test/{id}_stories_test.dart",
        "coqui/packages/coqui_story_checks/test/support/{id}_paths.dart",
        "coqui/packages/coqui_story_checks/test/support/{id}_rules.dart",
        "coqui/packages/coqui_story_checks/test/fixtures/{id}/**",
        "coqui/packages/coqui_story_checks/tool/{id}_paths_test.dart",
        "coqui/ref/pp/{id}/**"
      ]
    },
    "content_lines": {
      "kind": "language",
      "parents": [
        "content"
      ],
      "paths": [
        "content/lines/{lang}/**"
      ]
    }
  },
  "sanctioned_multi_package": {
    "scene_port": {
      "combinations": [
        [
          "coqui_scenes",
          "coqui_story_checks"
        ],
        [
          "coqui_scenes",
          "feature_story"
        ],
        [
          "coqui_scenes",
          "coqui_story_checks",
          "feature_story"
        ]
      ],
      "extra_paths": [
        "coqui/ref/pp/**"
      ],
      "branch_style": "story",
      "requires_label": null
    },
    "platform_progress": {
      "combinations": [
        [
          "coqui_platform",
          "coqui_progress"
        ]
      ],
      "branch_style": "lane",
      "requires_label": "multi-package-ok"
    },
    "platform_app": {
      "combinations": [
        [
          "app",
          "coqui_platform"
        ]
      ],
      "branch_style": "lane",
      "requires_label": "multi-package-ok"
    },
    "scenes_app": {
      "combinations": [
        [
          "app",
          "coqui_scenes"
        ]
      ],
      "branch_style": "lane",
      "requires_label": "multi-package-ok"
    }
  },
  "lanes": {
    "coqui_contracts": {
      "kind": "package",
      "paths": [
        "coqui/packages/core/coqui_contracts/**"
      ]
    },
    "coqui_progress": {
      "kind": "package",
      "paths": [
        "coqui/packages/core/coqui_progress/**"
      ]
    },
