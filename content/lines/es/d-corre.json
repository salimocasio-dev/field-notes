    "yo_coqui": {
      "who": "tu",
      "text": "¡Coquí!"
    },
    "qa01": {
      "who": "narr",
      "text": "Este es el parque."
    },
    "qa02": {
      "who": "narr",
      "text": "Luis está allá."
    },
    "qa03": {
      "who": "narr",
      "text": "¡Mira! El árbol grande."
    },
    "qa04": {
      "who": "narr",
      "text": "Carmen y Coquí están aquí. Y Canelo también."
    },
    "qa05": {
      "who": "narr",
      "habla": "luis",
      "text": "Luis dice: Uno. Dos. Tres. ¡A correr!"
    },
    "qa06": {
      "who": "narr",
      "text": "Carmen corre. Coquí corre. Y Canelo corre rápido."
    },
    "qa07": {
      "who": "narr",
      "text": "¡Mira! Un gato."
    },
    "qa08": {
      "who": "narr",
      "text": "Canelo mira al gato."
    },
    "qa09": {
      "who": "narr",
      "text": "El gato corre. ¡Y Canelo corre!"
    },
    "qa10": {
      "who": "narr",
      "habla": "luis",
      "text": "Luis dice: ¡No, Canelo! ¡Ven aquí!"
    },
    "qa11": {
      "who": "narr",
      "text": "Coquí espera."
    },
    "qa12": {
      "who": "narr",
      "text": "Carmen corre y corre."
    },
    "qa13": {
      "who": "narr",
      "text": "Carmen toca el árbol grande."
    },
    "qa14": {
      "who": "narr",
      "text": "¡Carmen gana!"
    },
    "qa15": {
      "who": "narr",
      "habla": "luis",
      "text": "Luis dice: ¡Muy bien, Carmen!"
    },
    "qa16": {
      "who": "narr",
      "text": "Ahora Coquí corre también."
    },
    "qa17": {
      "who": "narr",
      "text": "¿Y el gato? El gato está arriba, en el árbol."
    },
    "qa18": {
      "who": "narr",
      "text": "Canelo está abajo."
    },
    "qa19": {
      "who": "narr",
      "text": "Canelo está cansado."
    },
    "qa20": {
      "who": "narr",
      "text": "Y el gato está contento."
    }
