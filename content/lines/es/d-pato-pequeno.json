      "text": "¡Muy bien!"
    },
    "si_muy_bien": {
      "who": "narr",
      "text": "¡Sí! ¡Muy bien!"
    },
    "yo_coqui": {
      "who": "tu",
      "text": "¡Coquí!"
    },
    "qc01": {
      "who": "narr",
      "text": "Este es el lago."
    },
    "qc02": {
      "who": "narr",
      "text": "Hay tres patos."
    },
    "qc03": {
      "who": "narr",
      "text": "Un pato blanco."
    },
    "qc04": {
      "who": "narr",
      "text": "Un pato negro."
    },
    "qc05": {
      "who": "narr",
      "text": "Y un pato pequeño."
    },
    "qc06": {
      "who": "narr",
      "text": "¿De qué color es el pato pequeño? Es amarillo."
    },
    "qc07": {
      "who": "narr",
      "text": "Carmen tiene pan."
    },
    "qc08": {
      "who": "narr",
      "habla": "carmen",
      "text": "Carmen dice: Pan para el pato pequeño."
    },
    "qc09": {
      "who": "narr",
      "text": "¡Ay! El pato blanco es rápido. El pato blanco come el pan."
    },
    "qc10": {
      "who": "narr",
      "habla": "carmen",
      "text": "Carmen dice: Otra vez. Pan para el pato pequeño."
    },
    "qc11": {
      "who": "narr",
      "text": "¡Ay, no! Ahora el pato negro come el pan."
    },
    "qc12": {
      "who": "narr",
      "text": "El pato pequeño no tiene pan. Está triste."
    },
    "qc13": {
      "who": "narr",
      "habla": "carmen",
      "text": "Carmen dice: Toma, Coquí."
    },
    "qc14": {
      "who": "narr",
      "text": "Carmen tiene más pan. El pato blanco y el pato negro miran a Carmen."
    },
    "qc15": {
      "who": "narr",
      "text": "Coquí va despacio."
    },
    "qc16": {
      "who": "tu",
      "text": "Pan para el pato pequeño."
    },
    "qc17": {
      "who": "narr",
      "text": "¡El pato pequeño come el pan!"
    },
    "qc18": {
      "who": "narr",
      "habla": "luis",
      "text": "Luis dice: ¡Muy bien, Coquí!"
    },
    "qc19": {
      "who": "narr",
      "text": "Ahora el pato pequeño está contento."
    }
  }
